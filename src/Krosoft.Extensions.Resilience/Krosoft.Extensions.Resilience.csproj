<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageTags>Krosoft Extension Resilience Polly Circuit Breaker Retry Timeout</PackageTags>
		<Description>Package pour faciliter la mise en place de politiques de résilience HTTP (timeout, retry, circuit breaker).</Description>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
	</ItemGroup>
</Project>